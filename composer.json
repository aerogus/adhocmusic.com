{
    "name": "adhocmusic/adhocmusic.com",
    "description": "adhocmusic.com",
    "type": "project",
    "license": "proprietary",
    "eluceo/ical": "2.15.0",
    "require": {
        "php": ">=8.4",
        "phpmailer/phpmailer": "7.1.1",
        "wp-cli/php-cli-tools": "0.13.0",
        "twig/twig": "3.28.0",
        "twig/intl-extra": "3.26.0",
        "eluceo/ical": "2.17.0"
    },
    "authors": [
        {
            "name": "Guillaume Seznec",
            "email": "guillaume@seznec.fr",
            "homepage": "https://guillaume.seznec.fr",
            "role": "Developer"
        }
    ],
    "require-dev": {
        "squizlabs/php_codesniffer": "4.0.4",
        "phpunit/phpunit": "13.3.2",
        "phpstan/phpstan": "2.2.9",
        "phpstan/phpstan-strict-rules": "2.0.12",
        "vincentlanglet/twig-cs-fixer": "4.0.2"
    },
    "scripts": {
        "http": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t www/public"
        ],
        "stan": "./vendor/bin/phpstan analyse --memory-limit 512M",
        "pcs": "./vendor/bin/phpcs",
        "pcse": "./vendor/bin/phpcs -n",
        "tcs": "./vendor/bin/twig-cs-fixer lint www/views",
        "unit": "./vendor/bin/phpunit",
        "eslint": "./node_modules/.bin/eslint"
    }
}
